<?xml version="1.0" encoding="utf-8"?>
<!-- SSH keys belong to this device and Android user only; never include them in backups. -->
<full-backup-content>
    <exclude domain="file" path="git-identities/" />
    <exclude domain="file" path="git-known-hosts" />
    <exclude domain="file" path="git-tokens/" />
    <exclude domain="sharedpref" path="agent.xml" />
</full-backup-content>
